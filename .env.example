# ── Discord Bot Token ──────────────────────────────────────────────────────
# From: Discord Developer Portal → Application → Bot → Reset Token
DISCORD_BOT_TOKEN=your-bot-token-here

# ── Coding Channel ID ──────────────────────────────────────────────────────
# Right-click your #coding channel → "Copy Channel ID" (enable Developer Mode first)
# Leave as 0 to disable solve announcements.
CODING_CHANNEL_ID=0

# ── Daily Leaderboard Config ───────────────────────────────────────────────
# Role to @ping in the midnight summary (right-click @cplovers → Copy Role ID)
# Leave as 0 to disable role pinging.
CPLOVERS_ROLE_ID=0

# UTC time for the daily midnight announcement.
# Default: 18:30 UTC = 00:00 IST (UTC+5:30 India Standard Time).
# To calculate your local midnight in UTC: subtract your UTC offset.
#   e.g. UTC+5:30  → midnight IST = 18:30 UTC  → HOUR=18, MINUTE=30
#   e.g. UTC+0     → midnight UTC = 00:00 UTC  → HOUR=0,  MINUTE=0
#   e.g. UTC+8     → midnight SGT = 16:00 UTC  → HOUR=16, MINUTE=0
DAILY_UTC_HOUR=18
DAILY_UTC_MINUTE=30

# ── Turso Cloud Database (Recommended for Render 24/7 persistence) ──────────
# Create free at https://turso.tech/ -> Database URL & Auth Token
# If not set, the bot falls back to local SQLite (codeforces_bot.db).
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Database path (optional local fallback) ────────────────────────────────
# Defaults to codeforces_bot.db in the working directory when Turso is not set.
# DB_PATH=codeforces_bot.db
