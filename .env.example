# ── Discord Bot Token ──────────────────────────────────────────────────────
# From: Discord Developer Portal → Application → Bot → Reset Token
DISCORD_BOT_TOKEN=your-bot-token-here

# ── Coding Channel ID ──────────────────────────────────────────────────────
# Right-click your #coding channel → "Copy Channel ID" (enable Developer Mode first)
# Leave as 0 to disable solve announcements.
CODING_CHANNEL_ID=0

# ── Database path (optional) ───────────────────────────────────────────────
# Defaults to codeforces_bot.db in the working directory.
# DB_PATH=codeforces_bot.db
